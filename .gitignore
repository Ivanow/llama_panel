# Игнорируем вообще всё
*

# Явно разрешаем папки (чтобы Git заглянул внутрь)
!.gitignore
!doc/
!instances/
!logs/
!web_panel/
!build/
!build/bin/

# Разрешаем файлы в корне
!README.md
!README_EN.md
!LICENSE
!manager.sh
!requirements.txt

# Разрешаем бинарник
!build/bin/llama-server
!build/bin/.gitkeep

# Разрешаем содержимое папок
!doc/**
!instances/**
!logs/**
!web_panel/**

# Исключения
web_panel/__pycache__/
web_panel/models_cache.json
web_panel/panel_error.log
instances/*.conf
!instances/example.conf
logs/*
!logs/.gitkeep
