# Игнорируем вообще всё
*

# Явно разрешаем папки проекта
!.gitignore
!doc/
!instances/
!logs/
!web_panel/

# Разрешаем файлы в корне
!README.md
!README_EN.md
!LICENSE
!manager.sh
!requirements.txt
!install.sh

# Разрешаем содержимое папок
!doc/**
!instances/**
!logs/**
!web_panel/**

# Исключения (мусор)
web_panel/__pycache__/
web_panel/models_cache.json
web_panel/panel_error.log
instances/*.conf
!instances/example.conf
logs/*
!logs/.gitkeep

# Игнорируем папку build полностью (она собирается на месте)
build/

# Пользовательская локальная настройка (см. config.example.json)
config.json
